# SIMEA - Variaveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessario

# ============================================
# CONFIGURACOES DO AMBIENTE
# ============================================
ENVIRONMENT=development
NODE_ENV=development
PORT=3000

# ============================================
# BANCO DE DADOS (PostgreSQL/TimescaleDB)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=simea_dev
DATABASE_USER=simea
DATABASE_PASSWORD=simea123
DATABASE_SSL=false
DATABASE_POOL_SIZE=50
DATABASE_POOL_TIMEOUT=30000

# ============================================
# CACHE (Redis)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_DEFAULT=3600
REDIS_TTL_SESSION=86400
REDIS_TTL_TRANSACTION=300
REDIS_TTL_YIELD=1

# ============================================
# MENSAGERIA (Kafka)
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=simea
KAFKA_RETRIES=5
KAFKA_RETRY_DELAY=1000
KAFKA_MAX_MESSAGES=10000
KAFKA_FETCH_MIN_BYTES=1024
KAFKA_FETCH_MAX_WAIT=5000

# ============================================
# AUTENTICACAO (JWT)
# ============================================
JWT_SECRET=change_this_to_a_strong_random_string_with_at_least_64_characters
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=simea.gov.br
JWT_AUDIENCE=simea-api

# ============================================
# SESSAO
# ============================================
SESSION_SECRET=change_this_to_a_strong_random_string
SESSION_COOKIE_NAME=simea_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE=86400000

# ============================================
# INTEGRACAO QUANTICA
# ============================================
QUANTUM_API_URL=https://braket.us-east-1.amazonaws.com
QUANTUM_API_REGION=us-east-1
QUANTUM_API_KEY=your_aws_braket_api_key
QUANTUM_DEFAULT_QPU=arn:aws:braket:::device/quantum-simulator/amazon/sv1
QUANTUM_SIMULATOR=arn:aws:braket:::device/quantum-simulator/amazon/sv1
QUANTUM_TIMEOUT=300000
QUANTUM_MAX_RETRIES=3
QUANTUM_BATCH_SIZE=100

# ============================================
# API DREX/PIX (Banco Central)
# ============================================
DREX_API_URL=https://api.drex.bcb.gov.br
DREX_API_TIMEOUT=5000
DREX_MAX_RETRIES=3
PIX_API_URL=https://api.pix.bcb.gov.br
PIX_API_TIMEOUT=5000
PIX_MAX_RETRIES=3

# ============================================
# API INPE (Validacao Orbital)
# ============================================
INPE_API_URL=https://api.inpe.br
INPE_API_TIMEOUT=10000
INPE_MAX_RETRIES=3
INPE_SATELLITE_DATA=true

# ============================================
# API PORTOS (Controle Portuario)
# ============================================
PORT_API_URL=https://api.portos.gov.br
PORT_API_TIMEOUT=5000
PORT_MAX_RETRIES=3
PORT_DEFAULT_TARIFF=1.5

# ============================================
# CONFIGURACOES DO POOL SOBERANO
# ============================================
POOL_MIN_INVESTMENT=1000000
POOL_MAX_INVESTMENT=1000000000
POOL_DEFAULT_YIELD=12.5
POOL_MIN_YIELD=5
POOL_MAX_YIELD=25
POOL_AUDIT_THRESHOLD=10000000

# ============================================
# CONFIGURACOES DE RECUPERACAO JUDICIAL
# ============================================
RECOVERY_MIN_SCORE=70
RECOVERY_MAX_DEBT_RATIO=0.8
RECOVERY_MIN_COLLATERAL=1.2
RECOVERY_MAX_TERM=360

# ============================================
# CONFIGURACOES DE LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_TIMESTAMP=true
LOG_COLORIZE=false

# ============================================
# CONFIGURACOES DE MONITORAMENTO
# ============================================
METRICS_PORT=9090
METRICS_PREFIX=simea
HEALTH_CHECK_INTERVAL=5000

# ============================================
# CONFIGURACOES DO HFT ENGINE
# ============================================
HFT_PORT=8080
HFT_WORKERS=8
HFT_MAX_CONNECTIONS=10000
HFT_TRANSACTION_TIMEOUT=10
HFT_BATCH_SIZE=1000
HFT_FLUSH_INTERVAL=100

# ============================================
# CONFIGURACOES DE AUDITORIA
# ============================================
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=debug
AUDIT_STORAGE_TYPE=s3
AUDIT_S3_BUCKET=simea-audit-logs
AUDIT_S3_PREFIX=audit
AUDIT_RETENTION_DAYS=3650

# ============================================
# CONFIGURACOES DE API
# ============================================
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=60000
API_CORS_ORIGIN=*
API_MAX_REQUEST_SIZE=10mb
API_TIMEOUT=30000
