# Dockerfile para API Gateway (Node.js/TypeScript)
# Base: Node.js 18 LTS

FROM node:18-alpine as builder

# Instalar dependencias de build
RUN apk add --no-cache python3 make g++

# Copiar codigo fonte
WORKDIR /app
COPY api/package.json api/package-lock.json api/prisma/ ./api/
COPY api/src/ ./api/src/
COPY api/prisma/ ./api/prisma/

# Instalar dependencias
RUN cd api && \
    npm install && \
    npm run build

# Stage final
FROM node:18-alpine

# Copiar dependencias e build
COPY --from=builder /app/api/node_modules ./api/node_modules
COPY --from=builder /app/api/package.json ./api/package.json
COPY --from=builder /app/api/dist ./api/dist
COPY --from=builder /app/api/prisma ./api/prisma

# Criar usuario nao-root
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Configurar permissões
RUN mkdir -p /app/config /app/data && \
    chown appuser:appgroup /app -R

# Portas expostas
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s \
    CMD wget -q --spider http://localhost:3000/health || exit 1

# Executar como usuario nao-root
USER appuser
WORKDIR /app/api

# Comando de inicializacao
CMD ["node", "dist/main.js"]
